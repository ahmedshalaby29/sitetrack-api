{
  "name": "sitetrack-api",
  "version": "0.1.0",
  "description": "SiteTrack construction project and materials tracker – API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "verify": "tsx src/scripts/verify.ts",
    "benchmark": "tsx src/scripts/benchmark.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.3.2",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "tsx": "^4.19.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.1.4",
    "eslint": "^9.27.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  }
}
